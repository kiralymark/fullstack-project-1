@code {
    private string databaseDataString = "";
    private LoginVM loginModel = new LoginVM();

    private async Task HandleLogin()
    {
        var response = await Http.PostAsJsonAsync("api/authentication/login-user", loginModel);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<AuthResultVM>();
            
            //var result = await AuthenticationController.Login(loginModel);

            if (result != null)
            {
                // 1. Store the token in LocalStorage
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "authToken", result.Token);

                // 2. Notify Blazor of the state change
                ((CustomAuthenticationStateProvider)AuthenticationStateProvider).MarkUserAsAuthenticated(result.Token);
            }

        }

    }

    protected override async Task OnInitializedAsync()
    {
        await GetDataAsync();
    }

    private async Task GetDataAsync()
    {
        try
        {
            // Inject configuration from ASP.NET Core DI container (reads environment variables correctly)
            string connectionString = Configuration.GetConnectionString("PostgresDb") 
                ?? throw new InvalidOperationException("Connection string 'PostgresDb' not found.");

            await using var con = new NpgsqlConnection(connectionString);
            await con.OpenAsync();

            // (Note, wrap table and column names in double quotes to handle PostgreSQL case-sensitivity)
            //string query = "SELECT * FROM public.\"AspNetUsers\";"; 
            string query = "SELECT \"Email\" FROM public.\"AspNetUsers\";"; 
            
            await using var cmd = new NpgsqlCommand(query, con);
            await using var reader = await cmd.ExecuteReaderAsync();

            while (await reader.ReadAsync())
            {
                //string fullname = reader.IsDBNull(1) ? "" : reader.GetString(1);
                //string id = reader.GetString(0);
                string email = reader.GetString(0);

                //databaseDataString += $"id:{id},fullname:{fullname}; ";
                databaseDataString += $"email:{email}; ";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Database connection error: {ex.Message}");
            databaseDataString = $"Error loading data: {ex.Message}";
        }
    }
}
